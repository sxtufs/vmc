<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/pkgCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/pkgCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_count_pill"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="0"
        android:textColor="@color/vmpPurple"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pkgName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textColor="@color/vmpTextPrimary"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/pkgExpand"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="expand"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/vmpPurple" />
</LinearLayout>

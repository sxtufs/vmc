<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <EditText
        android:id="@+id/jksNameEdit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_box"
        android:gravity="center_vertical"
        android:hint="Name"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/vmpTextPrimary"
        android:textColorHint="@color/vmpTextSecondary"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/jksAliasEdit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_box"
        android:gravity="center_vertical"
        android:hint="Alias"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/vmpTextPrimary"
        android:textColorHint="@color/vmpTextSecondary"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/jksPasswordEdit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_box"
        android:gravity="center_vertical"
        android:hint="Password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/vmpTextPrimary"
        android:textColorHint="@color/vmpTextSecondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/jksCancelBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Cancel"
            android:textColor="@color/vmpPurple"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jksImportBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Import"
            android:textColor="@color/vmpPurple"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
